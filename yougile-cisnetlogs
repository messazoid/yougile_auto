#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    ""|--follow)
        if [ "$#" -gt 1 ]; then
            printf 'Usage: yougile-cisnetlogs [--follow|--once]\n' >&2
            exit 2
        fi
        exec journalctl -u music-verifier-cisnet.service -n 100 -f --no-pager -o short-iso
        ;;
    --once)
        if [ "$#" -gt 1 ]; then
            printf 'Usage: yougile-cisnetlogs [--follow|--once]\n' >&2
            exit 2
        fi
        exec journalctl -u music-verifier-cisnet.service -n 100 --no-pager -o short-iso
        ;;
    *)
        printf 'Usage: yougile-cisnetlogs [--follow|--once]\n' >&2
        exit 2
        ;;
esac
