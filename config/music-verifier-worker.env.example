# Required ACRCloud configuration. Replace credentials outside Git.
ACR_HOST=identify-eu-west-1.acrcloud.com
ACR_ACCESS_KEY=replace-with-acr-access-key
ACR_SECRET_KEY=replace-with-acr-secret-key

# Keep disabled until credentials, budget and staging checks are approved.
ACR_EXECUTE=0
ACR_MAX_RETRIES=2
ACR_RETRY_BASE_SECONDS=5
ACR_RETRY_MAX_SECONDS=60

# Shared source acquisition limit.
YANDEX_DISK_MAX_VIDEO_MB=2048
