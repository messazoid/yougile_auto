# Tracked configuration template. Never put real credentials in this file.
# Production systemd reads /etc/yougile-video.env and
# /etc/music-verifier-worker.env instead.

# Receiver and YouGile
WEBHOOK_SECRET=replace-with-a-long-random-secret
YOUGILE_API_BASE=https://yougile.com/api-v2
YOUGILE_API_KEY=replace-with-yougile-api-key
YOUGILE_ALLOWED_BOARD_IDS=
YOUGILE_ALLOWED_COLUMN_IDS=
YOUGILE_ALLOWED_TASK_IDS=
YOUGILE_ALLOWED_CHAT_IDS=
YOUGILE_COMPANY_ID=
YOUGILE_POLL_ENABLED=false
YOUGILE_POLL_TASK_ID=
YOUGILE_POLL_CHAT_ID=
YOUGILE_POLL_INTERVAL_SECONDS=30
YOUGILE_POLL_INITIAL_LIMIT=100
YOUGILE_POLL_MAX_CHATS_PER_CYCLE=10
YOUGILE_MAX_REQUESTS_PER_MINUTE=40
YOUGILE_SCOPE_REFRESH_SECONDS=300
YOUGILE_WEBHOOK_PUBLIC_BASE=https://example.invalid
MIN_FREE_DISK_MB=1024
MAX_VIDEO_MB=2048
YANDEX_DISK_MAX_VIDEO_MB=2048
FFMPEG_TIMEOUT_SECONDS=1800

# ACRCloud worker
ACR_HOST=identify-eu-west-1.acrcloud.com
ACR_ACCESS_KEY=replace-with-acr-access-key
ACR_SECRET_KEY=replace-with-acr-secret-key
ACR_EXECUTE=0
ACR_MAX_RETRIES=2
ACR_RETRY_BASE_SECONDS=5
ACR_RETRY_MAX_SECONDS=60

# CIS-Net adapter endpoint. Credentials belong to the CIS-Net repository.
CISNET_CDP_ENDPOINT=http://127.0.0.1:9223
