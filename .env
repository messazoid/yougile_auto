# Tracked Compose configuration without secret values.
# Fill the empty secret fields only on the target server and never commit them.

# Compose
COMPOSE_PROJECT_NAME=music-verifier
# New installs keep application state in ./data; older env files without this key keep the named volume.
MUSIC_DATA_SOURCE=./data
MUSIC_IMAGE=music-verifier:local
CISNET_RUNNER_IMAGE=music-verifier-cisnet-runner:local
CISNET_IMAGE=cisnet-playwright:local
CISNET_BUILD_CONTEXT=./cisnet-playwright
PYTHON_IMAGE=python:3.12-slim-bookworm
NODE_IMAGE=node:24-bookworm-slim
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.62.1-noble
APP_UID=10001
APP_GID=10001
RECEIVER_PORT=8080
NOVNC_PORT=6080

# Receiver and YouGile
WEBHOOK_SECRET=
YOUGILE_API_BASE=https://yougile.com/api-v2
YOUGILE_API_KEY=
YOUGILE_ALLOWED_BOARD_IDS=
YOUGILE_ALLOWED_COLUMN_IDS=
YOUGILE_ALLOWED_TASK_IDS=
YOUGILE_ALLOWED_CHAT_IDS=
YOUGILE_COMPANY_ID=
YOUGILE_POLL_ENABLED=false
YOUGILE_POLL_TASK_ID=
YOUGILE_POLL_CHAT_ID=
YOUGILE_POLL_INTERVAL_SECONDS=30
YOUGILE_POLL_INITIAL_LIMIT=100
YOUGILE_POLL_MAX_CHATS_PER_CYCLE=10
YOUGILE_MAX_REQUESTS_PER_MINUTE=40
YOUGILE_SCOPE_REFRESH_SECONDS=300
YOUGILE_WEBHOOK_PUBLIC_BASE=https://example.invalid
MIN_FREE_DISK_MB=1024
MAX_VIDEO_MB=2048
YANDEX_DISK_MAX_VIDEO_MB=2048
FFMPEG_TIMEOUT_SECONDS=1800

# ACRCloud worker
ACR_HOST=identify-eu-west-1.acrcloud.com
ACR_ACCESS_KEY=
ACR_SECRET_KEY=
ACR_EXECUTE=0
ACR_MAX_RETRIES=2
ACR_RETRY_BASE_SECONDS=5
ACR_RETRY_MAX_SECONDS=60

# CIS-Net. CDP stays on the internal Compose network.
CISNET_EMAIL=
CISNET_PASSWORD=
VNC_PASSWORD=
CISNET_INTERVAL_SECONDS=60
CISNET_EXECUTE=0
