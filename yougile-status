#!/usr/bin/env bash
set -euo pipefail

units=(
    music-verifier.target
    yougile-receiver.service
    music-verifier-worker.service
    music-verifier-cisnet.service
    music-verifier-cisnet.path
    music-verifier-cisnet.timer
    cisnet-desktop.service
    cisnet-cdp-browser.service
)

case "${1:-}" in
    "")
        for unit in "${units[@]}"; do
            state=$(systemctl is-active "$unit" 2>/dev/null) || true
            printf '%-40s %s\n' "$unit" "${state:-unknown}"
        done
        ;;
    --full)
        exec systemctl status "${units[@]}" --no-pager
        ;;
    -h|--help)
        printf 'Usage: yougile-status [--full]\n'
        ;;
    *)
        printf 'Usage: yougile-status [--full]\n' >&2
        exit 2
        ;;
esac
