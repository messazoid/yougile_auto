#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    printf 'Usage: sudo yougile-restart\n'
    printf 'Restarts the pipeline target and CIS-Net path/timer; an active CIS-Net desktop is left untouched.\n'
    exit 0
fi
if [ "$#" -ne 0 ]; then
    printf 'Usage: sudo yougile-restart\n' >&2
    exit 2
fi
if [ "$(id -u)" -ne 0 ]; then
    printf 'yougile-restart: run with sudo or as root\n' >&2
    exit 2
fi

systemctl restart \
    music-verifier.target \
    music-verifier-cisnet.path \
    music-verifier-cisnet.timer

/opt/music-verifier/yougile-status
