#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
REPO_ROOT="${YOUGILE_REPO_ROOT:-$(dirname -- "$SCRIPT_DIR")}"
ENV_FILE="${YOUGILE_ENV_FILE:-/etc/music-verifier.env}"
PROJECT_DIR="$REPO_ROOT"
PROJECT_NAME="${YOUGILE_PROJECT_NAME:-music-verifier}"

if [[ ! -f "$PROJECT_DIR/compose.yaml" ]]; then
  echo "yougile-compose: compose.yaml not found under $PROJECT_DIR" >&2
  exit 2
fi
if [[ "$(id -u)" -eq 0 ]]; then
  if [[ ! -r "$ENV_FILE" ]]; then
    echo "yougile-compose: env file is unavailable: $ENV_FILE" >&2
    exit 2
  fi
  COMPOSE_COMMAND=(
    docker compose --project-name "$PROJECT_NAME"
    --project-directory "$PROJECT_DIR" --env-file "$ENV_FILE"
  )
  DOCKER_COMMAND=(docker)
else
  if ! sudo test -r "$ENV_FILE"; then
    echo "yougile-compose: env file is unavailable: $ENV_FILE" >&2
    exit 2
  fi
  COMPOSE_COMMAND=(
    sudo docker compose --project-name "$PROJECT_NAME"
    --project-directory "$PROJECT_DIR" --env-file "$ENV_FILE"
  )
  DOCKER_COMMAND=(sudo docker)
fi

compose() {
  "${COMPOSE_COMMAND[@]}" "$@"
}

exec_compose() {
  exec "${COMPOSE_COMMAND[@]}" "$@"
}

exec_cli() {
  if [[ -t 0 && -t 1 ]]; then
    exec_compose exec "$@"
  else
    exec_compose exec -T "$@"
  fi
}

command_name="$(basename "$0")"

case "$command_name" in
  yougile-start)
    [[ "$#" -eq 0 ]] || { echo "Usage: yougile-start" >&2; exit 2; }
    exec_compose up -d
    ;;
  yougile-stop)
    [[ "$#" -eq 0 ]] || { echo "Usage: yougile-stop" >&2; exit 2; }
    exec_compose stop receiver worker cisnet-runner
    ;;
  yougile-restart)
    [[ "$#" -eq 0 ]] || { echo "Usage: yougile-restart" >&2; exit 2; }
    exec_compose up -d --force-recreate receiver worker cisnet-runner
    ;;
  yougile-status)
    case "${1:-}" in
      "") [[ "$#" -eq 0 ]] || { echo "Usage: yougile-status [--full]" >&2; exit 2; }
          exec_compose ps -a ;;
      --full) [[ "$#" -eq 1 ]] || { echo "Usage: yougile-status [--full]" >&2; exit 2; }
          compose ps -a
          compose top ;;
      -h|--help) echo "Usage: yougile-status [--full]" ;;
      *) echo "Usage: yougile-status [--full]" >&2; exit 2 ;;
    esac
    ;;
  yougile-logs)
    follow=1
    all=0
    for argument in "$@"; do
      case "$argument" in
        --once) follow=0 ;;
        --follow) follow=1 ;;
        --all) all=1 ;;
        *) echo "Usage: yougile-logs [--follow|--once] [--all]" >&2; exit 2 ;;
      esac
    done
    view_options=()
    [[ "$all" -eq 1 ]] && view_options+=(--all)
    if [[ "$follow" -eq 1 ]]; then
      compose logs --no-color --tail=100 --follow receiver worker cisnet-runner cisnet-browser |
        python3 "$REPO_ROOT/docker/compose_logs.py" "${view_options[@]}"
    else
      compose logs --no-color --tail=200 receiver worker cisnet-runner cisnet-browser |
        python3 "$REPO_ROOT/docker/compose_logs.py" "${view_options[@]}"
    fi
    ;;
  yougile-httplogs)
    follow=1
    all=0
    for argument in "$@"; do
      case "$argument" in
        --once) follow=0 ;;
        --follow) follow=1 ;;
        --all) all=1 ;;
        *) echo "Usage: yougile-httplogs [--follow|--once] [--all]" >&2; exit 2 ;;
      esac
    done
    view_options=(--http-only)
    [[ "$all" -eq 1 ]] && view_options+=(--all)
    if [[ "$follow" -eq 1 ]]; then
      compose logs --no-color --tail=100 --follow receiver |
        python3 "$REPO_ROOT/docker/compose_logs.py" "${view_options[@]}"
    else
      compose logs --no-color --tail=200 receiver |
        python3 "$REPO_ROOT/docker/compose_logs.py" "${view_options[@]}"
    fi
    ;;
  yougile-cisnetlogs)
    follow=1
    for argument in "$@"; do
      case "$argument" in
        --once) follow=0 ;;
        --follow) follow=1 ;;
        *) echo "Usage: yougile-cisnetlogs [--follow|--once]" >&2; exit 2 ;;
      esac
    done
    if [[ "$follow" -eq 1 ]]; then
      compose logs --no-color --tail=100 --follow cisnet-runner cisnet-browser |
        python3 "$REPO_ROOT/docker/compose_logs.py" --all
    else
      compose logs --no-color --tail=200 cisnet-runner cisnet-browser |
        python3 "$REPO_ROOT/docker/compose_logs.py" --all
    fi
    ;;
  yougile-runs)
    exec_cli receiver python src/yougile_runs.py "$@"
    ;;
  yougile-resolve)
    columns_mode=0
    for argument in "$@"; do
      [[ "$argument" == "--columns" ]] && columns_mode=1
    done
    if [[ "$columns_mode" -eq 0 ]]; then
      exec_cli receiver python src/yougile_resolve.py "$@"
    fi
    transcript="$(mktemp)"
    trap 'rm -f -- "$transcript"' EXIT
    compose exec -T receiver python src/yougile_resolve.py "$@" | tee "$transcript"
    selected="$(sed -n 's/^YOUGILE_RESOLVE_SELECTED_COLUMN_IDS=//p' "$transcript" | tail -n 1)"
    if [[ -n "$selected" ]]; then
      if [[ "$(id -u)" -eq 0 ]]; then
        python3 "$REPO_ROOT/bin/update-allowed-columns.py" "$ENV_FILE" "$selected"
      else
        sudo python3 "$REPO_ROOT/bin/update-allowed-columns.py" "$ENV_FILE" "$selected"
      fi
      echo "Обновлён $ENV_FILE. Для применения выполните yougile-restart."
    fi
    ;;
  yougile-cisnet)
    exec_cli cisnet-runner python docker/cisnet-wrapper.py "$@"
    ;;
  recognize-wav)
    if [[ "$#" -lt 1 ]]; then
      echo "Usage: recognize-wav [-i] INPUT.wav [--force]" >&2
      exit 2
    fi
    if [[ "${1:-}" == "-i" || "${1:-}" == "--input" ]]; then
      shift
    fi
    if [[ "$#" -lt 1 || ! -f "$1" ]]; then
      echo "recognize-wav: input WAV is unavailable" >&2
      exit 2
    fi
    input="$1"
    shift
    name="$(basename -- "$input")"
    remote="/tmp/yougile-manual-${BASHPID}-${name}"
    trap 'compose exec -T -u 0 worker rm -f -- "$remote" >/dev/null 2>&1 || true' EXIT
    compose cp "$input" "worker:$remote"
    compose exec -T -u 0 worker chmod 0644 -- "$remote"
    compose exec -T worker python src/recognize_wav.py -i "$remote" "$@"
    ;;
  yougile-env)
    exec sudoedit "$ENV_FILE"
    ;;
  yougile-reset-data)
    if [[ "$#" -eq 0 || ( "$#" -eq 1 && ( "$1" == "-h" || "$1" == "--help" ) ) ]]; then
      echo "Plan: stop this Compose project and permanently remove ${PROJECT_NAME}_music-data."
      echo "The CIS-Net browser profile volume remains intact."
      echo "Usage: yougile-reset-data --execute 'RESET MUSIC-VERIFIER DATA'"
      exit 0
    fi
    if [[ "$#" -ne 2 || "$1" != "--execute" || "$2" != "RESET MUSIC-VERIFIER DATA" ]]; then
      echo "Usage: yougile-reset-data --execute 'RESET MUSIC-VERIFIER DATA'" >&2
      exit 2
    fi
    compose down --remove-orphans
    "${DOCKER_COMMAND[@]}" volume rm "${PROJECT_NAME}_music-data"
    ;;
  *)
    echo "Unknown command: $command_name" >&2
    echo "Install and call one of the yougile-* commands." >&2
    exit 2
    ;;
esac
