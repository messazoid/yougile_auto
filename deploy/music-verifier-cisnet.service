[Unit]
Description=Search new completed aggregation exports in CIS-Net
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/music-verifier
ExecStart=/opt/music-verifier/venvs/receiver/bin/python /opt/music-verifier/src/cisnet_automation.py
TimeoutStartSec=infinity
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/music-verifier/data/cisnet /opt/music-verifier/data/queue
