#!/bin/sh
cd /opt/music-verifier || exit 1
company_id="${YOUGILE_COMPANY_ID:-}"
if [ -r /etc/yougile-video.env ]; then
    company_id=$(sed -n 's/^YOUGILE_COMPANY_ID=//p' /etc/yougile-video.env | tail -n 1)
fi
if [ "$(id -un)" = "yougile" ]; then
    exec env YOUGILE_COMPANY_ID="$company_id" /opt/music-verifier/venvs/receiver/bin/python /opt/music-verifier/src/yougile_runs.py "$@"
fi
exec runuser -u yougile -- env YOUGILE_COMPANY_ID="$company_id" /opt/music-verifier/venvs/receiver/bin/python /opt/music-verifier/src/yougile_runs.py "$@"
